{
  "openapi": "3.0.3",
  "info": {
    "title": "ZeePay Gateway - Collections API",
    "version": "1.0.0",
    "description": "A PrimePay Payment Gateway Collections API Mock (asynchronous collections).\nAuthentication: Provide either Basic Auth OR X-Authorization header.\n"
  },
  "servers": [
    {
      "url": "https://api-mnhbogxrsa-uc.a.run.app",
      "description": "Base URL"
    }
  ],
  "tags": [
    {
      "name": "Collections",
      "description": "Initiate asynchronous wallet collections"
    },
    {
      "name": "Transactions",
      "description": "Query transaction status"
    },
    {
      "name": "Register Callback",
      "description": "Register callback URL for transaction status updates"
    }
  ],
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic",
        "description": "Basic authentication header as provided during onboarding."
      },
      "xAuthorization": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Authorization",
        "description": "X-Authorization header as provided during onboarding."
      }
    },
    "schemas": {
      "TransactionStatus": {
        "type": "object",
        "required": [
          "amount",
          "currency",
          "final_status",
          "order_id",
          "transaction_id",
          "payer_number",
          "response_code",
          "response_message",
          "narration"
        ],
        "properties": {
          "amount": {
            "type": "string",
            "example": "1"
          },
          "currency": {
            "type": "string",
            "example": "ZMW"
          },
          "final_status": {
            "type": "integer",
            "description": "Transaction final status code. 270 = IP is not allowed. 300 = Transaction completed successfully. 301 = Transaction failed. 303 = Ambiguous Transaction. 289 = An unknown error occurred.",
            "example": 301
          },
          "order_id": {
            "type": "string",
            "description": "Client external unique id (external_reference).",
            "example": ""
          },
          "transaction_id": {
            "type": "string",
            "description": "PrimePay transaction id.",
            "example": ""
          },
          "payer_number": {
            "type": "string",
            "description": "Mobile number of the wallet debited.",
            "example": "260973936164"
          },
          "response_code": {
            "type": "integer",
            "description": "Transaction status code.",
            "example": 200
          },
          "response_message": {
            "type": "string",
            "description": "Transaction status description.",
            "example": "Transaction failed"
          },
          "username": {
            "type": "string",
            "description": "Client username (may be included in responses/callbacks).",
            "example": ""
          },
          "password": {
            "type": "string",
            "description": "Client password (may be included in responses/callbacks).",
            "example": ""
          },
          "account_number": {
            "type": "string",
            "description": "Transaction account number.",
            "example": ""
          },
          "narration": {
            "type": "string",
            "description": "Client's transaction description.",
            "example": "Lorem ipsum"
          }
        },
        "additionalProperties": true,
        "example": {
          "amount": "1",
          "currency": "ZMW",
          "final_status": 301,
          "order_id": "380613032205PPR10000",
          "transaction_id": "CCT390813032205P10301",
          "payer_number": "260973936164",
          "account_number": "260973936164",
          "username": "XXXXXX",
          "password": "XXXXXX",
          "response_code": 200,
          "response_message": "Transaction failed",
          "account_number ": "TESTACC",
          "narration ": "Lorem ipsum"
        }
      },
      "CallbackRegistrationRequest": {
        "type": "object",
        "required": [
          "callback_url"
        ],
        "properties": {
          "callback_url": {
            "type": "string",
            "description": "URL to receive transaction status updates.",
            "example": "https://example.com/callback"
          }
        }
      },
      "CollectRequest": {
        "type": "object",
        "required": [
          "payer_number",
          "external_reference",
          "payment_narration",
          "currency",
          "amount"
        ],
        "properties": {
          "payer_number": {
            "type": "string",
            "description": "Mobile number of the wallet to be debited.",
            "example": "260973983884"
          },
          "external_reference": {
            "type": "string",
            "description": "Unique external transaction id.",
            "example": "28780184x5000-50y00-0000-0046000"
          },
          "payment_narration": {
            "type": "string",
            "description": "Payment narration from external system.",
            "example": "test transaction"
          },
          "currency": {
            "type": "string",
            "description": "Transaction currency. ZMW is default for Zambia.",
            "example": "ZMW"
          },
          "amount": {
            "type": "string",
            "description": "Transaction amount.",
            "example": "1.0"
          },
          "account_number": {
            "type": "string",
            "nullable": true,
            "description": "Any ID that can be used for reference.",
            "example": "TEST101"
          }
        }
      },
      "MessageResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "example": {
          "message": "request received for processing successfully"
        }
      },
      "UnauthorizedResponse": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "integer",
            "example": 285
          },
          "message": {
            "type": "string",
            "example": "provided credentials are incorrect or inactive"
          },
          "clientId": {
            "nullable": true
          },
          "services": {
            "nullable": true
          }
        }
      },
      "BadRequestResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "example": {
          "message": "Duplicate external id"
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "example": {
          "message": "Not found"
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Unauthorized (missing/invalid credentials).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/UnauthorizedResponse"
            }
          }
        }
      },
      "BadRequest": {
        "description": "Bad request (invalid payload / validation failures).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/BadRequestResponse"
            }
          }
        }
      },
      "InternalServerError": {
        "description": "Internal server error.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "basicAuth": []
    },
    {
      "xAuthorization": []
    }
  ],
  "paths": {
    "/api/v2/transaction/collect": {
      "post": {
        "tags": [
          "Collections"
        ],
        "summary": "Initiate an asynchronous collection request",
        "description": "Client submits a collection request. The API is asynchronous: a 202 indicates the request\nwas accepted for processing; the final status arrives via callback/webhook or can be polled\nusing fetch-status.\n",
        "security": [
          {
            "basicAuth": []
          },
          {
            "xAuthorization": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CollectRequest"
              },
              "examples": {
                "sample": {
                  "summary": "Sample collection request",
                  "value": {
                    "payer_number": "260973983884",
                    "external_reference": "28780184x5000-50y00-0000-0046000",
                    "payment_narration": "test transaction",
                    "currency": "ZMW",
                    "amount": "1.0",
                    "account_number": "TEST101"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted for processing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                },
                "examples": {
                  "accepted": {
                    "value": {
                      "message": "request received for processing successfully"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/api/v2/callback/register": {
      "post": {
        "tags": [
          "Register Callback"
        ],
        "summary": "Register a callback URL request",
        "description": "You can use this endpoint to register a callback URL for transaction status updates.\n The callback URL must be publicly accessible. It will be called via HTTP POST. The payload will be a JSON object of type 'TransactionStatus'.",
        "security": [
          {
            "basicAuth": []
          },
          {
            "xAuthorization": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CallbackRegistrationRequest"
              },
              "examples": {
                "sample": {
                  "summary": "Sample callback registration request",
                  "value": {
                    "callback_url": "https://example.com/callback"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Callback URL registered successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                },
                "examples": {
                  "registered": {
                    "value": {
                      "message": "callback URL registered successfully"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/v2/transaction/fetch-status/{id}": {
      "get": {
        "tags": [
          "Transactions"
        ],
        "summary": "Fetch status of a transaction by external reference id",
        "description": "Returns the status of a transaction if a transaction with the provided external id is available.\nOtherwise returns 404.\n",
        "security": [
          {
            "basicAuth": []
          },
          {
            "xAuthorization": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "External transaction id (external_reference / order_id)",
            "schema": {
              "type": "string"
            },
            "example": "380613032205PPR10000"
          }
        ],
        "responses": {
          "200": {
            "description": "Transaction status returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionStatus"
                },
                "examples": {
                  "sample": {
                    "value": {
                      "amount": "1",
                      "currency": "ZMW",
                      "final_status": 301,
                      "order_id": "380613032205PPR10000",
                      "transaction_id": "CCT390813032205P10301",
                      "payer_number": "260973936164",
                      "account_number": "TESTACC",
                      "username": "XXXXXX",
                      "password": "XXXXXX",
                      "response_code": 200,
                      "response_message": "Transaction id is invalid",
                      "narration": "Lorem ipsum"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Transaction not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "notFound": {
                    "value": {
                      "message": "Not found"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    }
  }
}